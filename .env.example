# Supabase Postgres connection URL (use the Session pooler connection string).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Required only when the target database has no existing users.
# Use a unique strong value and store it as a Vercel secret.
MITAS_INITIAL_ADMIN_PASSWORD=

# Optional local SQLite location. Do not commit the database file.
MITAS_SQLITE_PATH=

# Set temporarily only for the documented CLI recovery of a sole Admin account.
MITAS_ADMIN_RECOVERY_PASSWORD=
